END

STRINGTABLE
BEGIN
    ID_FILE_COMPARE_FILES       "Compare two files side by side\nCompare Files"
    ID_FILE_COMPARE_FOLDERS     "Compare two folders recursively\nCompare Folders"
    ID_FILE_OPEN_PR             "Open a GitHub pull request by URL\nOpen Pull Request"
    ID_FILE_REFRESH             "Reload the current comparison\nRefresh"
    IDM_EXIT                    "Quits the application\nExit"
    ID_EDIT_COPY                "Copy the selected lines to the Clipboard\nCopy"
    ID_EDIT_SELECTALL           "Select all lines of the active side\nSelect All"
    ID_VIEW_FIRST_DIFF          "Go to the first difference\nFirst Difference"
    ID_VIEW_PREV_DIFF           "Go to the previous difference\nPrevious Difference"
    ID_VIEW_NEXT_DIFF           "Go to the next difference\nNext Difference"
    ID_VIEW_LAST_DIFF           "Go to the last difference\nLast Difference"
    ID_VIEW_IGNORE_WS           "Ignore whitespace changes when comparing lines\nIgnore Whitespace"
    ID_VIEW_SHOW_IDENTICAL      "Show or hide identical files in the tree\nShow Identical Files"
    ID_VIEW_SWAP                "Swap the left and the right side\nSwap Sides"
    IDM_ABOUT                   "Display the program information\nAbout"
END
